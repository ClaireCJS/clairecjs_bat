        rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
        rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
        rem ************************************ REPOSITORY & WORKFLOW VARIABLES: END **********************************************************
        rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
        rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————












    rem :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
    :ValidateFolderExists [drive dir handler]
        rem NOTE: first 2 arguments are mandatory names of environment variables
        rem       third   argument  is  optional  name  of handler, so far only containing MAKE(=make missing folders).

        rem Debug
            REM echo ValidateFolderExists [drive=%drive dir=%dir handler=%handler] {PERFORM_VALIDATIONS='%PERFORM_VALIDATIONS%'}

        rem Don't do this if we've decided not to
            if %PERFORM_VALIDATIONS ne 1 (return)

        rem Update window title
            SET TITLETMP=%_WINTITLE
            title Validating: %dir%

        rem Check parameters exist
            if "%DEBUG_VALIDATIONS%" != "1"  goto :Debug_Validations_No 
                echo. 
                color bright   cyan on black %+ echos * `` 
                color          cyan on black %+ echos ValidateFolderExists%@RANDCURSOR[]
                color bright   cyan on black %+ echos [ 
                color bright   cyan on black %+ echos %%%dir%%% 
                :olor bright   blue on black %+ echos  %drive% 
                color bright yellow on black %+ echos  %handler%
                color bright   cyan on black %+ echo ]
                color         white on black
            :Debug_Validations_No 
            gosub ValidateIfEnvironmentVariableIsDefined %drive%
            gosub ValidateIfEnvironmentVariableIsDefined %dir%

        rem Dereference parameters to transform from environment variable names to actual values:
            set actualDrive=%[%drive%]
            set actualDir=%[%dir%]

        rem Dont check if the drive isn't ready; the machine may be down or something, 
        rem we can't wait any measurable time on this:
            if "%DEBUG_VALIDATIONS%" == "1" (color yellow on black %+ echos           .............checking if drive is ready... %+ color bright yellow on black %+ echos %actualDrive%: %+ color yellow on black %+ echos ...)
            set  READY=%@READY[%actualDrive%]
            if "%DEBUG_VALIDATIONS%" != "1" goto :Debug_Validations_No_2 
                                    set COLOR=magenta
                if "%READY%" == "0" set COLOR=red
                if "%READY%" == "1" set COLOR=green
                *color        %COLOR% on black %+ echos ...ready value for 
                *color bright %COLOR% on black %+ echos  %actualDrive%: 
                *color        %COLOR% on black %+ echos  is "
                *color bright %COLOR% on black %+ echos %READY%
                *color        %COLOR% on black %+ echo "
                *color         white  on black
            :Debug_Validations_No_2

        rem Return if the folder exists, otherwise, handle the error:
            if "%DEBUG_VALIDATIONS%" != "1" goto :Debug_Validations_No_3
                *color        cyan on black %+ echos           .............checking if folder exists.... 
                *color bright cyan on black %+ echos %actualDir% 
                *color        cyan on black %+ echo .
                *color       white on black
            :Debug_Validations_No_3
            if exist %actualDir% goto :returnNow %+ rem quick kludge to make this work for files too
            if isdir %actualDir% goto :returnNow
            set ERRMSG=* ERROR! %dir% of %actualDir% does not exist! (%%%%READY for %actualDrive%: is %READY%)
            %COLOR_WARNING% %+ echo  %ERRMSG% %+ title %ERRMSG% %+ %COLOR_NORMAL% 
                if "%handler%" == "MAKE" goto :Handle_MAKE
                                         goto :Handle_DONE
                        :Handle_MAKE
                            echo ...Attempting to create it for you.
                            md %actualDir%
                        goto :Handle_DONE
                :Handle_DONE
            rem pause
    :returnNow
    title %TITLETMP%
    return
    rem ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
   












rem ::::::::::::::::::::::::::::::::::::::::EXECUTABLE FILE EXTENSIONS (AND FILE MASKS) ::::::::::::::::::::::::::::::::::::::::::::::::::::
:DefineExecutableFileExtensions

        rem Read everything we can from a file for speed:
                if exist c:\bat\extensions.env (set /r c:\bat\extensions.env)    %+ rem faster to read from file

        rem Work around TCC weird env var loading for aliased env vars:
                rem set ALL_SONGS_FILELIST=%MP3OFFICIAL%\lists\everything.m3u
                rem set FLUSH_VARIABLES=%ALL_SONGS_LIST% %ALL_SONGS_FILELIST% %ALL_SONGS_PLAYLIST% 
                for %%tmpvar in (ALL_SONGS_PLAYLIST NOW_PLAYING_TXT) set %tmpvar=%[%tmpvar%]
        
        rem Dynamically generate the same thing with spaces instead of semicoluns:
                    rem same thing delimited by space instead of semicolon:
                for %v in (FILEMASK_APPLICATION FILEMASK_ARCHIVE FILEMASK_AUDIO FILEMASK_CODE FILEMASK_COMIC_BOOK FILEMASK_DISC FILEMASK_DISC_IMAGE FILEMASK_DISK FILEMASK_DISK_IMAGE FILEMASK_FILELIST FILEMASK_IMAGE FILEMASK_MUSIC FILEMASK_RICHTEXT FILEMASK_TEXT FILEMASK_VIDEO) (gosub CreateFileMaskWithSpaces %v %+ gosub CreateFileMaskWithExtensions %v)
                goto :SkipSub1
                        :CreateFileMaskWithSpaces [varname]
                            if not defined %VARNAME%_W_SPACES set %VARNAME%_W_SPACES=%@replace[;, ,%[%varname%]]
                        return
                        :CreateFileMaskWithExtensions [varname]
                            if not defined %VARNAME%_EXTENSIONS set %VARNAME%_EXTENSIONS=%@replace[*,,%@replace[.,,%@replace[;, ,%[%varname%]]]]
                        return
                :SkipSub1


        rem And one filemask to rule them all (FILEMASK_ALL, FILEMASK_ALL_REGEX):
                set FILEMASK_ALL=%FILEMASK_FILELIST%;%FILEMASK_TXT%;%FILEMASK_RICHTEXT%;%FILEMASK_SCRIPT%;%FILEMASK_CODE%;%FILEMASK_APPLICATION%;%FILEMASK_ARCHIVE%;%FILEMASK_DISC_IMAGE%;%FILEMASK_IMAGE%;%FILEMASK_AUDIO%;%FILEMASK_VIDEO%;%FILEMASK_COMIC_BOOK%;%FIEMASK_MISC% %+ rem Returns something like: *.m3u;*.sfv;;*.html;*.htm;*.doc;*.rtf;*.docx;*.mht;*.pdf;*.url;*.btm;*.bat;*.cmd;*.sh;*.btm;*.bat;*.cmd;*.sh;*.pl;*.py;*.java;*.bat;*.btm;*.sql;*.asm;*.bas;*.c;*.h;*.java;*.pas;*.php;*.sql;*.vbs;*.exe;*.apk;*.msi;*.com;*.zip;*.rar;*.tar;*.gz;*.7z;*.arj;*.jar;*.r00;*.r01;*.ace;*.001;*.iso;*.img;*.jpg;*.jpeg;*.gif;*.png;*.bmp;*.webp;*.ico;*.tif;*.tiff;*.pcx;*.art;*.dcm;*.jfif;*.jpg_large;*.png_large;*.mp3;*.wav;*.rm;*.voc;*.au;*.mid;*.stm;*.mod;*.vqf;*.ogg;*.mpc;*.wma;*.mp4;*.flac;*.snd;*.aac;*.opus;*.ac3;*.mkv;*.avi;*.mp4;*.m4a;*.flv;*.mov;*.wmv;*.mpg;*.mpeg;*.vob;*.bdmv;*.ts;*.m2ts;*.rm;*.qt;*.asf;*.asx;*.fli;*.swf;*.m4v;*.webm;*.f4v;*.rm;*.ram;*.3gp
                rem set FILEMASK_ALL_DELIMITED_BY_PIPE=%@ReReplace[\*\.,,%@ReReplace[\;,,%@ReReplace[;\*\.,`|`,%filemask_all%]]] %M rem Returns something like: m3u|sfv|html|htm|doc|rtf|docx|mht|pdf|url|btm|bat|cmd|sh|btm|bat|cmd|sh|pl|py|java|bat|btm|sql|asm|bas|c|h|java|pas|php|sql|vbs|exe|apk|msi|com|zip|rar|tar|gz|7z|arj|jar|r00|r01|ace|001|iso|img|jpg|jpeg|gif|png|bmp|webp|ico|tif|tiff|pcx|art|dcm|jfif|jpg_large|png_large|mp3|wav|rm|voc|au|mid|stm|mod|vqf|ogg|mpc|wma|mp4|flac|snd|aac|opus|ac3|mkv|avi|mp4|m4a|flv|mov|wmv|mpg|mpeg|vob|bdmv|ts|m2ts|rm|qt|asf|asx|fli|swf|m4v|webm|f4v|rm|ram|3gp
                setdos /x-5
                set TEMP_FMASK_VAR=%@ReReplace[\;,,%@ReReplace[\*\.,`|`\\.,%filemask_all%]]
                set FILEMASK_ALL_REGEX=(%@LTrim[|,%TEMP_FMASK_VAR])
                setdos /x0

        rem And a flag to indicate our filemasks have been set:
                set FILEMASKS_HAVE_BEEN_SET=1

return



rem ::::::::::::::::::::::::::::::::::::::::EXECUTABLE FILE EXTENSIONS (AND FILE MASKS) ::::::::::::::::::::::::::::::::::::::::::::::::::::
