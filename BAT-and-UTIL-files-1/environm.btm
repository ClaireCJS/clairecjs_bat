        rem ::::::::::::::::: INITIAL[%MACHINENAME%] FUNCTIONS - MOSTLY FOR REDEFINING C-DRIVE ::::::::::::::::: 
        :InitialBroadway
                set TABLET=1
                set OSBIT=32
        return

        :InitialDemona
                rem hardware
                        set CPU_CORES=16 %+ set OPTIMAL_CPU_THREADS=12 %+ REM guessing on optimal cpu threads here
                        set HD1000G3=C   %+ set C=HD1000G3  %+  set HD1T3=C  %+ set DEMONA1T=C  %+ SET  HD1T3_PRESENCE=%HD1T3%:\__ I awaken! __
                rem CUDA kludge:
                        set cuda_path=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.1
                rem software
                        SET OS=10
                        rem OS_USERNAME=Claire
                        set OS_USERNAME=%MAPPING_DEMONA_USR% 
                        rem runalot [everytime environm is run]
                        rem stop annoying CCC:AEMCapturingWindow that keeps popping up: c:\util\windowhide.exe /kill AMD:CCC-AEMCapturingWindow :20150825 try removing this
                        rem bugfix kludges
                        set PROGRAMFILES=c:\Program Files
                        *window /trans=254
        return

        :InitialThailog
                rem hardware
                        set CPU_CORES=6 %+ set OPTIMAL_CPU_THREADS=9
                        rem HD240G=C    %+ rem C=HD240G
                        rem HD240G2=C   %+ rem C=HD240G2
                        SET HD512G=C    %+ SET C=HD512G
                        set NETWORK_NIC_TO_REACH_UNTETHERED_MACHINES_INTERFACE_NUM=13 %+ REM Network card's interface number in the "routes" command, for the network card used to reach non-tethered machines (i.e. i.e. those machines not sharing the tethered internet connection and retaining their normal broadband network configurations)
                rem software
                        SET OS=10
                        REM OS_USERNAME=%MAPPING_THAILOG_USR% -- this is the default but on this machine we had to make a separate user for sharing so this wouldn't match
                        set OS_USERNAME=claire
                        rem runalot [everytime environm is run]
                        rem stop annoying CCC:AEMCapturingWindow that keeps popping up: c:\util\windowhide.exe /kill AMD:CCC-AEMCapturingWindow :20150825 try removing this
                        rem bugfix kludges
                        set PROGRAMFILES=c:\Program Files
        return

        :InitialGoliath
                rem hardware
                        set CPU_CORES=4 %+ set OPTIMAL_CPU_THREADS=2
                        rem MAXIMUM_TIME_FOR_TCC_TO_START=5 changed to 9 on 2025/02/18 because Demona’s was lengthened
                        set MAXIMUM_TIME_FOR_TCC_TO_START=9
                        SET HD1000G=C %+ SET C=HD1000G
                        set NETWORK_NIC_TO_REACH_UNTETHERED_MACHINES_INTERFACE_NUM=12 %+ REM Network card's interface number in the "routes" command, for the network card used to reach non-tethered machines (i.e. i.e. those machines not sharing the tethered internet connection and retaining their normal broadband network configurations)
                rem software
                        SET OS=10
                        *window /trans=228            
                        rem OS_USERNAME=carolyn
                        set OS_USERNAME=%MAPPING_GOLIATH_USR% %+ REM 202308-/Windows 10
        return

        :InitialWyvern
                *window /trans=228            
                set CPU_CORES=12 %+ set OPTIMAL_CPU_THREADS=12
                set MAXIMUM_TIME_FOR_TCC_TO_START=4
                set MAXIMUM_TIME_FOR_TCC_TO_START=7
                SET C=HD2T1
                SET HD2T1=C 
                SET OS=11
                rem OS_USERNAME=carolyn
                set OS_USERNAME=%MAPPING_WYVERN_USR% 
        return

        :InitialHades
                rem hardware
                        SET HD256G=C %+  SET C=HD256G
                rem software
                        SET OS=7
                        set OS_USERNAME=oh
                rem had a weird PHP install back then
                        set PHP_PEAR_SYSCONF_DIR=%ProgramFiles%\PHP
                        set PHP_PEAR_INSTALL_DIR=%ProgramFiles%\PHP\pear
                        set     PHP_PEAR_DOC_DIR=%ProgramFiles%\PHP\docs
                        set     PHP_PEAR_BIN_DIR=%ProgramFiles%\PHP
                        set    PHP_PEAR_DATA_DIR=%ProgramFiles%\PHP\data
                        set     PHP_PEAR_PHP_BIN=%ProgramFiles%\PHP\php.exe
                        set    PHP_PEAR_TEST_DIR=%ProgramFiles%\PHP\tests
        return

        :InitialFire
                rem hardware
                        SET HD300G=C %+  SET C=HD300G  %+ REM or should we be setting SHARE300G=C ?? confused about what to do here :)
                rem software
                        SET OS=XP
                        set OSBIT=32
                        set OS_USERNAME=Administrator
        return

        :InitialMist
                SET C=HD25G
                SET HD25G=C 
                SET OS=XP
                set OS_USERNAME=carolyn
                set OSBIT=32
        return

        :InitialTemplate %+ REM Consider: When new computer is added - add new function here
                rem hardware
                        set CPU_CORES=6 %+ set OPTIMAL_CPU_THREADS=9
                        SET HD[TODO]G=C %+ SET C=HD[TODO]G
                        set NETWORK_NIC_TO_REACH_UNTETHERED_MACHINES_INTERFACE_NUM=[TODO] %+ REM Secondary network card (ethernet cable #2)'s interface number in the "routes" command
                rem software
                        SET OS=7
                        set username=claire
                        set OS_USERNAME=%MAPPING_WYVERN_USR% 
        return

        :InitialWork
                rem :not any more.... call %BAT%\work\set-[EMPLOYERNAME]-environment-vars
                rem PERSONAL:
                        SET MUSICSERVER=localhost:%MUSICSERVERPORT%
                        SET CONTACTS=c:\recycler\#.dat
                rem LAPTOP:
                        set MY_DOMAIN_USERNAME=asdf
                        set MY_DOMAIN_PASSWORD=asdf
                rem JAVA:
                        if isdir "c:\Program Files\Java\jdk1.7.0_71"          set JAVA_HOME=c:\Program Files\Java\jdk1.7.0_71
                        if isdir "c:\Program Files\Java\jdk1.7.0_76"          set JAVA_HOME=c:\Program Files\Java\jdk1.7.0_76
                        if exist "C:\Program Files\Java\jre-1.8\bin\java.exe" set JAVA_64BT=C:\Program Files\Java\jre-1.8\bin\java.exe
                rem MAVEN:
                        set    TRUNK=c:\dharness\trunk
                        set  M2_REPO=c:\Users\jlip\.m2\repository
                        set  M2_HOME=C:\util\MAVEN\apache-maven-3.0.5
                :Validate:
                        rem MAIN:
                        set CDRIVE=C
                        set C_DRIVE=%CDRIVE%
                        %gosubValidateFolderExists% CDRIVE TRUNK
                        %gosubValidateFolderExists% CDRIVE M2_REPO
                        %gosubValidateFolderExists% CDRIVE M2_HOME
                        rem ORACLEXE:
                                set ORACLE_HOME=C:\oraclexe\app\oracle\product\11.2.0\server
                                set ORACLE_SID=XE
                                %gosubValidateFolderExists% CDRIVE ORACLE_HOME
                        rem WEBLOGIC:
                                set  ORACLE_DOMAIN=diss
                                SET WEBLOGICDOMAIN=C:\Oracle\Middleware\Oracle_Home\user_projects\domains\%ORACLE_DOMAIN%
                                SET WEBLOGIC_DOMAIN=%WEBLOGICDOMAIN%
                                SET        MW_HOME=C:\Oracle\Middleware
                                SET    WEBLOGICJAR=c:\Oracle\Middleware\wlserver_10.3\server\lib\weblogic.jar
                                %gosubValidateFolderExists% CDRIVE WEBLOGICDOMAIN
                                %gosubValidateFolderExists% CDRIVE MW_HOME
        return

        
