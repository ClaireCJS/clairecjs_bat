@loadbtm on
@Echo off
@set PERFORMANCE_TUNING=0 %+ rem if %PERFORMANCE_TUNING eq 1 (timer /9 /q on)



@set rgb_index=1
@echos %@CHAR[27][2                                %+ rem Cursor=steady
@echos %@CHAR[27][ q%@CHAR[27]]12;#550000%@CHAR[7] %+ rem Cursor=dark red %+ rem @gosub :set_next_cursor_color_in_rainbow_sequence 

@rem SPEEDUP VERDICT #1: We need to separate all our validation calls into one location, then put them in an if/else so we don't go into validation subroutines over and over
@rem SPEEDUP VERDICT #2: We need to move repositories, other environment variables, into a separate environm.env file much like private.env

 
@rem NOTE: 2023: used "option" command to change Advanced-)Special Characters-)Parameter from "&" back to "$" which is the value it's supposed to have. "&" was for 4DOS compatibility


 


:DESCRIPTION: This is to define my command-line environment variables.
:ASSUME:      %MACHINENAME has been set.
:USAGE:       environm
:USAGE:       environm force    - to run through the script *fully*, which is only otherwise done once——when TCC is launched
:USAGE:       environm validate - to validate all repository locations as being accessible
:USAGE:       environm autoexec - for specific behavior when environm.btm is force-called from autoexec.btm
:USAGE:       environm debug    - for debugging





rem ::::::::::::::::::::::::::::::::::::::::::::CHAY-CHAY-CHANGES :::::::::::::::::::::::::::::::::::::::::::::::::::::::::
        rem When a new computer   is     added: run new-computer .bat {search this script for 'Consider: When new computer is added'}
        rem When a new harddrive  is     added: run new-harddrive.bat {will need to know letter}
    rem When a old harddrive  is     moved to another computer: move it in checkmappings.bat
         rem When a new harddrive  is [re]moved: whichdrive {driveletter} to get HDxxxxG environment variable, then editgrep HDxxxxG to edit all scripts mentioning it
    rem When a new repository is   created: create backup job in backup-repositories.bat
rem ::::::::::::::::::::::::::::::::::::::::::::CHAY-CHAY-CHANGES :::::::::::::::::::::::::::::::::::::::::::::::::::::::::















rem ::::::::::::::::::::::::::::::::::::::::COMMAND-LINE/ENVIRONMENT PARAMETERS: ::::::::::::::::::::::::::::::::::::::::::::::::
        rem Ways to keep this script from being run too often:
                rem 1) TCSTART.BAT can pass a "TCSTART" parameter so that we can tell when this has been run and not run it repeatedly
                rem 2) Secondary shells start from a different INI-specified location, using a different TCStart.bat, which sets SECONDARYSHELL=1
                rem 3) We also set ENVIRONM_RUN=1 after running, to prevent successive timewasting runs
        iff "%1" == "force" .or. "%1" == "-force" .or. "%1" == "validate" then
                rem We are in force mode! Skip these particular validations!
        else                
            if  "1" == "%ENVIRONM_RUN%"                                  (goto :The_Very_END  )   %+ REM added this line 2023/07/26
            if  "1" == "%ENVIRONM_RUN%" .and. "%@UPPER[%1]" == "TCSTART" (goto :The_Very_END  )   %+ REM so as of 2023/07/26 this line should never happen
            if  "1" == "%SECONDARYSHELL%"                                (goto :SecondaryShell)
        endiff

    rem DEBUG & VALIDATIONS can be turned on with these:
        if "%@UPPER[%1]" == "VALIDATE" (set PERFORM_VALIDATIONS=1 %+ set DEBUG_VALIDATIONS=1 %+ call wake-all-drives)
        if "%@UPPER[%1]" == "AUTOEXEC" (set PERFORM_VALIDATIONS=1 %+ set AUTOEXEC=1                                 )
        if "%@UPPER[%1]" == "DEBUG"    (set   DEBUG_VALIDATIONS=1 %+ set DEBUG_TMP=%DEBUG%   %+ set DEBUG=1         )

    rem VALIDATIONS take a full 0.5 seconds longer if you actually call the routine, vs turning the call itself into a REM statement when we're not doing them
                                        set gosubValidateFolderExists=rem gosub ValidateFolderExists
        if %PERFORM_VALIDATIONS eq 1   (set gosubValidateFolderExists=    gosub ValidateFolderExists)

    rem Similar approach to reduce time-footprint of the performance tuning itself:      
                                        set QUIET_TIMER_OR_NOT=/q
                                        set gosub_stopwatch_button=rem gosub stopwatch_button
        if %PERFORMANCE_TUNING  eq 1   (set gosub_stopwatch_button=    gosub stopwatch_button
                                        set QUIET_TIMER_OR_NOT=/9 /s)

rem ::::::::::::::::::::::::::::::::::::::::COMMAND-LINE/ENVIRONMENT PARAMETERS :::::::::::::::::::::::::::::::::::::::::::::::::







   rem ANSI COLORS & EMOJI ENV VARS:
        %gosub_stopwatch_button% yellow "      %STAR%[2]CommonEnvVarsIncludingNetworking --- b4 ansi"               
        if "%COLORS_HAVE_BEEN_SET%" != "1" .or. "%1" == "force" (call c:\bat\set-ansi          force)                
        rem 2024/11/15: this is the point at which bug disappearing pentagrams come back. Just wanted to verify that this fixes it.
        gosub :set_next_cursor_color_in_rainbow_sequence

        %gosub_stopwatch_button% yellow "      %STAR%[2]CommonEnvVarsIncludingNetworking --- after ansi b4 emoji"   
        if "%EMOJIS_HAVE_BEEN_SET%" != "1" .or. "%1" == "force" (call c:\bat\set-emojis        force)
        gosub :set_next_cursor_color_in_rainbow_sequence

        %gosub_stopwatch_button% yellow "      %STAR%[2]CommonEnvVarsIncludingNetworking --- after emoji"           
        if   not  defined   MESSAGE_TYPES                       (call c:\bat\print-message vars_only) %+ rem some variables that this sets, which we sometimes want before it is ever run
        gosub :set_next_cursor_color_in_rainbow_sequence








rem ::::::::::::::::::::::::::::::::::::::::CONFIGURATION :::: ::::::::::::::::::::::::::::::::::::::::
