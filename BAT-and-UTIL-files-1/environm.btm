                rem 💻***** MUSIC SERVER STUFF: ***** 
                
                        rem Set which machine is our Music Server, and what it's IP address is:
                                rem moved to environment-common-vars ➜ SET   MUSICSERVERMACHINENAME=DEMONA
                                rem moved to environment-common-vars ➜ SET   MUSICSERVERIPONLY=%IP_DEMONA%
                                rem moved to environment-common-vars ➜ set   WINAMP_INTEGRATION_GENERAL=0
                                if  "%MUSICSERVERMACHINENAME%" == "%MACHINENAME%" (set MUSICSERVERIPONLY=localhost   %+ set WINAMP_INTEGRATION_GENERAL=1)
                                if   "WORK"                    == "%MACHINENAME%" (set MUSICSERVERIPONLY=%PUBLIC_IP% %+ set WINAMP_INTEGRATION_GENERAL=1)
                                
                        rem Music server stuff: Set the port of the music server web interface, and 'MUSICSERVER' which is a [badly-named] URL-base:                        
                                rem moved to environment-common-vars ➜ set MUSICSERVERPORT=666
                                rem moved to environment-common-vars ➜ SET MUSICSERVER=%MUSICSERVERIPONLY%:%MUSICSERVERPORT%
                                rem moved to environment-common-vars ➜ set MUSICSERVERSTATUSURL=http://%MUSICSERVER%/main
                                
                        rem Music server stuff: Which drive is the C: drive of the music server?
                                iff "%MUSICSERVERMACHINENAME%" == "%MACHINENAME%" then
                                        set MUSICSERVERCDRIVE=C
                                else                                
                                        rem MUSICSERVERCDRIVE=%HD240G2%                                          
                                        rem MUSICSERVERCDRIVE=%HD512G%                                          
                                        SET MUSICSERVERCDRIVE=%HD1T3%                                          
                                endiff                  
                                set MUSICSERVERC_DRIVE=%MUSICSERVERCDRIVE%                               %+ rem just an alias

