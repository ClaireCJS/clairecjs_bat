rem ::::::::::::::::::::::::::::: MAIN :::::::::::::::::::::::::::::::::::::
rem ::::::::::::::::::::::::::::: MAIN :::::::::::::::::::::::::::::::::::::
rem ::::::::::::::::::::::::::::: MAIN :::::::::::::::::::::::::::::::::::::


    rem Var to track that we are in the middle of running this:
            set RUNNING_ENVIRONM=1
            

        gosub :set_next_cursor_color_in_rainbow_sequence


    rem gosub StartKillBots { call c:\bat\slui-killbot } { @processmonitor slui started forever (taskend /f slui) } %+ REM stupid slui process kept stealing focus around 2015...  Use focus-monitor.exe to debug that situation. This keeps it dead, but the monitor only lasts per-command-line window, so we need it in this CLI initialization script. But wait! It eats up CPU, so it might not actually be worth it.
        gosub PreliminaryErrorCheck               %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after PreliminaryErrorCheck           " %+ rem 0.03
        if exist c:\bat\private.env (set /r c:\bat\private.env)    %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after SetPrivateEnvVars               " %+ rem ?.???                                                                                                                                                        %+ rem set private environment variables this way now, so this file can be published without violating personal confidentiality
        gosub SetTCCBehaviorOptions               %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after SetTCCBehaviorOptions"            %+ rem never timed
        gosub DefineHarddrivesAndDriveMapping     %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after DefineHarddrivesAndDriveMapping " %+ rem 0.59  59
        gosub CommonEnvVarsIncludingNetworking    %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after CommonEnvVarsIncludingNetworking" %+ rem 0.04
        gosub Initial%MACHINENAME%                %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after Initial                         " %+ rem 0.11
        gosub DefineRepositories                  %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after DefineRepositories              " %+ rem 1.20  !!!!!!!
        gosub DefineExecutableFileExtensions      %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after DefineExecutableFileExtensions  " %+ rem 0.24 
        gosub SetUsernameAndNetName               %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after SetUsernameAndNetName           " %+ rem 0.04
        gosub Initial%USERNAME%                   %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after Initial                         " %+ rem 0.01
        gosub SetPathAndPromptAndCursor           %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after SetPathAndPromptAndCursor       " %+ rem 0.29->.21 1st/autoexec-run .005 successive runs
        gosub LoadAliases                         %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after LoadAliases                     " %+ rem 0.02
        gosub CheckForSyncedDevices               %+               %+ set nope=t_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after CheckForSyncedDevices           " %+ rem 0.01
        gosub OSSpecificOverrides                 %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after OSSpecificOverrides             " %+ rem 0.05
        gosub SetJavaClasspath                    %+               %+ set nope=t_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after SetJavaClasspath                " %+ rem 0.25  25
        gosub Load_TCC_Plugins                    %+               %+ gosub :set_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after Load_TCC_Plugins                " %+ rem 0.13
        gosub FinalValidations                    %+               %+ set nope=t_next_cursor_color_in_rainbow_sequence    %+      %gosub_stopwatch_button% orange "after FinalValidations                " %+ rem 0.013
        goto :END

    return


