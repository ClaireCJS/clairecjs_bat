rem Define Servers:

        rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
        rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
        rem ************************************ SERVER(s) DELINEATION: BEGIN: ************************************
        rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
        rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
                rem WHO'S THE BOSS?
                rem echos %@RANDCURSOR[]
                rem MASTER/PRIMARY MACHINE:
                    rem CONSIDER THIS: WHEN NEW COMPUTER IS ADDED
                    rem MACHINENAME_SCRIPT_AND_DROPBOX_AUTHORITY=THAILOG                            %+ rem 2015ish
                    rem moved to environment-common-vars ➜ set MACHINENAME_SCRIPT_AND_DROPBOX_AUTHORITY=DEMONA                             %+ rem 20221022
                    iff "%MACHINENAME_SCRIPT_AND_DROPBOX_AUTHORITY%" == "%MACHINENAME%" then
                            set MACHINENAME_SCRIPT_AND_DROPBOX_AUTHORITY_CDRIVE=C
                    else
                        rem MACHINENAME_SCRIPT_AND_DROPBOX_AUTHORITY_CDRIVE=%HD240G2%                   
