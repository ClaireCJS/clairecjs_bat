        rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
                rem CLAIRE-VIRONMENT VARIABLE DEFAULT VALUES:
                        rem Operating-system values:
                                rem done in environm-common-vars -> SET OS=10
                                rem done in environm-common-vars -> SET OSBIT=64
                        rem Main locations: BAT:
                                rem done in environm-common-vars -> SET BATDRIVE=C
                                rem done in environm-common-vars -> SET BAT=%BATDRIVE%:\BAT
                                rem done in environm-common-vars -> SET HOME=%BAT%
                        rem Main locations: UTIL:
                                rem done in environm-common-vars -> SET UTILDRIVE=C
                                if     isdir %UTILDRIVE%:\UTIL (SET UTIL=%UTILDRIVE%:\UTIL)
                                if not isdir %UTILDRIVE%:\UTIL (SET UTIL=%BAT%            )
                                rem done in environm-common-vars -> set UTIL1DRIVE=%UTILDRIVE%
                                rem done in environm-common-vars -> set UTIL1=%UTIL%
                                rem done in environm-common-vars -> set UTIL2DRIVE=C
                                rem done in environm-common-vars -> SET UTIL2=%UTIL2DRIVE%:\UTIL2
                        rem Default text editor, and separate BG command to call the text in the background:
                                rem done in environm-common-vars -> SET EDITOR=call ep
                                rem done in environm-common-vars -> SET EDITORBG=call epb
                                rem done in environm-common-vars -> set BIGEDITOR="%Program Files%\SlickEdit Pro 21.0.0\win\vs.exe" %+ rem Editor for *VERY LARGE* files
                        rem Screen metrics:
                                rem done in environm-common-vars -> SET  WIDTH=%@WINMETRICS[0]  
                                rem done in environm-common-vars -> SET HEIGHT=%@WINMETRICS[1]
                        rem Common aliases for values:
                                rem done in environm-common-vars -> SET TMPDIR=%TEMP%
                        rem Deprecated default prompt time ━ definitely NOT used in AskYn.bat or Pause-For-X-Seconds.bat:
                                rem done in environm-common-vars -> SET     DECISIONTIME=60
                rem VALIDATE OUR VALUES:
                        %gosubValidateFolderExists%   BATDRIVE BAT
                        %gosubValidateFolderExists%  UTILDRIVE UTIL
                        %gosubValidateFolderExists% UTIL1DRIVE UTIL1
                        %gosubValidateFolderExists% UTIL2DRIVE UTIL2            
        rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
