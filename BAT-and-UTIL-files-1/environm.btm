:SetUsernameAndNetName
    rem we allow a flag to be passed to skip this, because going by machinename can go against wishes when using terminal services (RDP):
        if "%ENVIRONM_BAT_DO_NOT_SET_USERNAME%"=="1" goto :set_user_name_NO
                                                     goto :set_user_name_YES
        :set_user_name_YES
            rem default user
                SET   USERNAME=claire
                SET    NETNAME_DEAD=cLInTJcl
                SET    NETNAME_FEM=ClioCJS
                SET    NETNAME_CLAIRE=ClaireCJS
                SET    NETNAME=%NETNAME_FEM%
                set  KNOWNNAME=Claire          %+ set KNOWN_NAME=%KNOWNNAME%
                set   DEADNAME=%@CHAR[67]%@CHAR[108]%@CHAR[105]%@CHAR[110]%@CHAR[116]
                set  DEAD_NAME=%DEADNAME%

            rem other users set by machinename
                REM Consider: When new computer is added
                if "%@UPPER[%MACHINENAME%]" == "MAGIC"   goto :Set_Carolyn
                if "%@UPPER[%MACHINENAME%]" == "MIST"    goto :Set_Carolyn
                if "%@UPPER[%MACHINENAME%]" == "GOLIATH" goto :Set_Carolyn
                if "%@UPPER[%MACHINENAME%]" == "WYVERN"  goto :Set_Carolyn
                                                         goto :Set_Carolyn_DONE
                            :Set_Carolyn
                                SET USERNAME=carolyn
                                SET  NETNAME=CarolynCASL
                                SET  NETNAME_FEM=%NETNAME%
                                set KNOWNNAME=Carolyn
                                set MV_DRY_RUN_FIRST=1
                            :Set_Carolyn_DONE

            rem If nothing defined, grab from username:
                if "" == "%KNOWNNAME%" set KNOWNNAME=%_WINUSER

            rem Alias-ize
                set KNOWN_NAME=%KnownName%

            rem Validate
                rem echo * Username is now %USERNAME
                if "%USERNAME%"  == "" gosub username_not_found
                if "%KNOWNNAME%" == "" gosub knownname_not_found

        :set_user_name_NO
return











