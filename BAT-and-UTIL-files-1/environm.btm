                                rem moved to environment-common-vars ➜ set MP3BACKUP2DRIVE=%HD20T1    %+ set MP3BACKUP2=%MP3BACKUP2DRIVE%:\BACKUPS\mp3 %+ rem Thailog copy
                                rem moved to environment-common-vars ➜ set MP3BACKUP3DRIVE=%HD18000G% %+ set MP3BACKUP3=%MP3BACKUP3DRIVE%:\mp3         %+ rem Demona  copy
                                rem Aliases:
                                        rem moved to environment-common-vars ➜ set MP3_BACKUP_1_DRIVE=%MP3BACKUP1DRIVE%
                                        rem moved to environment-common-vars ➜ set MP3_BACKUP_2_DRIVE=%MP3BACKUP2DRIVE%
                                        rem moved to environment-common-vars ➜ set MP3_BACKUP_3_DRIVE=%MP3BACKUP3DRIVE%
