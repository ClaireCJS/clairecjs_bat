:CheckForSyncedDevices
        :We used this for awhile, but currently, this isn't what we want: call CheckForMP3PlayerSync.bat
        REM call validate-environment-variables HD1T3_PRESENCE HD18T3_PRESENCE
return




:SetPathAndPromptAndCursor
    rem don't do it if we're not supposed to
        if %ENVIRONM_BAT_DO_NOT_SET_PROMPT eq 1 (goto :DoNotSetPrompt)

            rem timer /6 on
            rem make sure required scripts are present:
                if not exist %BAT%\setpath.bat   (call alarm-beep NO SETPATH.BAT!! %+ pause /# 10)
                if not exist %BAT%\setprompt.bat (call alarm-beep NO SETROMPT.BAT! %+ pause /# 10)
            rem call required scripts:
                call         %BAT%\setpath.bat
                call         %BAT%\setprompt.bat
            rem call machine-specific scripts:
                if     exist %BAT%\%MACHINENAME\setpath.bat   call %BAT%\%MACHINENAME\setpath.bat
                if     exist %BAT%\%MACHINENAME\setprompt.bat call %BAT%\%MACHINENAME\setprompt.bat
            rem timer /6 off

            rem This doesn't quite go here but doesn't have a better place to go here and this is the best timing
            call c:\bat\detect-command-line-container
    :DoNotSetPrompt

    if %CURSOR_SET% ne 1 (call set-cursor)
return




:LoadAliases
        unalias *                         
                                                           set ALIASES=c:\BAT\alias.lst
        if "%OS" == "7"                                    set ALIASES=c:\TCMD\alias.lst
        if "%OS" == "XP"                                   set ALIASES=c:\4NT\alias.lst
        if "%OS" == "ME" .or. "%OS"=="95" .or. "%OS"=="98" set ALIASES=c:\4DOS\alias.lst
        if exist c:\bat\alias.lst                          set ALIASES=c:\bat\alias.lst
        if not exist %ALIASES% (%COLOR_ALARM% %+ echo * ERROR: Aliases file not found! %+ beep %+ beep %+ beep %+ *pause)
        alias  /r    %ALIASES%
return





:OSSpecificOverrides
        if "%OS" == "11"  goto :Specifics_YES_7_and_also_win10_and_win11
        if "%OS" == "10"  goto :Specifics_YES_7_and_also_win10_and_win11
        if "%OS" == "7"   goto :Specifics_YES_7_and_also_win10_and_win11
                          goto :Specifics_NO
                          :^^^^^^^^^^^^^^^^^^^^ may be high time to make it default to yes (202304)
                          
                :Specifics_YES_7_and_also_win10_and_win11
                        alias zip=call %BAT%\zip.bat
                        :alias deltree=if isdir %%1 *del /a: /f /k /p /s /t /x /z /Nj %%1
                        :alias deltree=if isdir %%1 *del /a: /f /k /p /s /t /x /z /Nj %%1
                        :alias deltree2023=if isdir %%1 rd /s /q %%1
                         alias deltree=call deltree.bat 
                        :^^^^^ might add /y to force 'yes' to all prompts, but first let's get comfy with being prompted, then remove /p, then add /y
                        
                        window detach
                        :223 @ 20110523ish
                        :222 @ 20110601ish
                        :221 @ 20110623
                        :220 @ 20110712
                        :218 @ 20110726
                        :215 @ 20110913
                        :213 @ 20111014
                        :211 @ 20111113
                        :209 @ 20111210
                        :205 @ 20120228 (meant to do it on 20120127)
                        :201 @ 20120607
                        :197 @ 20130225
                        :193 @ 20150604
                        :197 @ 20151003 (too much before, I think)
                        :201 @ 20220525 (guess my vision is going)
                        :210 @ 20221103 (guess my vision is going)
                        :242 @ 20221119 (guess my vision is going)
                        :254 @ 20260310 (10-bit color makes transparency more visual or something?)
                        window /TRANS=254
            rem By the way, as of 20151003, this exhibits a weird behavior - the window /trans command run here is special.
            rem ****IF**** you are running Actual Window Manager.  When you move the window around, it will snap back to the transparency
            rem level here, even if you issue other window /trans commands later. It is as if Actual Window Manager gets "attached" to the
            rem initial transprency level, and wants to return to it whenever it notices you've moved the window around.
            rem Not sure if this is still the case in 2026.
return




        rem :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
        :SetJavaClasspath
                unset /q CLASSPATH
                unset /q CLASSPATHTEMP
                :Java_Versions (do newer ones on top so they appear first in the classpath when we have multiple versions)
                gosub AddFolderToClassPathEndOnlyIfItExists "%ProgramFiles%\Java\jdk1.7.0_71\lib"
                gosub AddFolderToClassPathEndOnlyIfItExists "%ProgramFiles%\Java\jdk1.7.0_25\lib"
                gosub AddFolderToClassPathEndOnlyIfItExists "%ProgramFiles%\Java\jdk1.6.0_35\lib"
                if "%TRUNK%" == "" goto :NoTrunk1
                        gosub AddFolderToClassPathEndOnlyIfItExists  %TRUNK%\maven-diss\diss\diss-jvs-datadictionary\target\test-classes
                        gosub AddFolderToClassPathEndOnlyIfItExists  %TRUNK%\maven-diss\diss\diss-jvs-datadictionary\target\classes
                :NoTrunk1
                if "%M2_REPO%" == "" goto :NoM2Repo
                        gosub AddFileToClassPathEndOnlyIfItExists    %M2_REPO\javax\javaee-web-api\6.0\javaee-web-api-6.0.jar
                        gosub AddFileToClassPathEndOnlyIfItExists    %M2_REPO\log4j\log4j\1.2.16\log4j-1.2.16.jar
                        gosub AddFileToClassPathEndOnlyIfItExists    %M2_REPO\junit\junit\4.0\junit-4.0.jar
                        gosub AddFileToClassPathEndOnlyIfItExists    %M2_REPO\com\oracle\ojdbc6\11.1.0\ojdbc6-11.1.0.jar
                :NoM2Repo
                        gosub AddFolderToClassPathEndOnlyIfItExists  C:\eclipse2\configuration\org.eclipse.osgi\bundles\346\2\.cp
                        gosub AddFolderToClassPathEndOnlyIfItExists  C:\eclipse2\configuration\org.eclipse.osgi\bundles\345\2\.cp
                :echo classpathtemp is %classpathtemp% %+ echo. %+ echo.
                set CLASSPATH=%CLASSPATHTEMP%
        return
                        rem ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
                        :AddFolderToClassPathEndOnlyIfItExists [folder]
                                if isdir %folder% set CLASSPATHTEMP=%CLASSPATHTEMP%;%folder%
                                rem echo * classpathtemp is now %CLASSPATHTEMP%
                        return
                        rem ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
                        rem ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
                        :AddFileToClassPathEndOnlyIfItExists [file]
                                if exist  %file%  set CLASSPATHTEMP=%CLASSPATHTEMP%;%file%
                                rem echo * classpathtemp is now %CLASSPATHTEMP%
                        return
                        rem ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
       rem :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
    



    


        rem :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
        :FinalValidations
                if %FINAL_VALIDATIONS_RUN eq 1 (goto :FinalValidationsDone)
                        if not defined STAR        (set  STAR=*) %+ rem Star is just a choice of asterisk. In our case we use 🌟 which is more easily noticeable in console output. This is defined in set-emoji.bat
                        if not defined GATEWAY     (call error "gateway not defined in %0! run 'ipconfig /all' and look for the 'Default Gateway' with an IP4 address")
                        if not defined OS_USERNAME (set  OS_USERNAME=%_winuser %+ if not defined OS_USERNAME (call error "OS_USERNAME not defined in %0!"))
                        set FINAL_VALIDATIONS_RUN=1
                :FinalValidationsDone
        return
        rem :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::





    rem ::::::::::::::::::::::::::::: ERROR SUBROUTINES: BEGIN: :::::::::::::::::::::::::::::::::::::
    rem ::::::::::::::::::::::::::::: ERROR SUBROUTINES: BEGIN: :::::::::::::::::::::::::::::::::::::
    rem ::::::::::::::::::::::::::::: ERROR SUBROUTINES: BEGIN: :::::::::::::::::::::::::::::::::::::

        :ValidateIfEnvironmentVariableIsDefined [varName]
                set   VALUE=%%%varName%%%
                iff "%value%" == "" then
                        set MSG=* ERROR! %italics_on%%blink_on%%varName%%blink_off%%italics_off% is not defined!
                        %COLOR_ALARM% 
                                         echo %MSG% 
                                        title %MSG%
                        %COLOR_NORMAL%
                        repeat 2 
                        *pause
                endiff                
        return

        :NoMachineName
                %COLOR_ALARM% %+ Echo you must have MACHINENAME set!! %+ echo.  %+ %COLOR_WARNING%
                echo !!!!!!!!!!!!!!!ALL COOL STUFF WILL BE BROKEN!!!!!!!!!!!!!! %+ echo !!!!!!!!!!!!!!!ALL COOL STUFF WILL BE BROKEN!!!!!!!!!!!!!!
                echo !!!!!!!!!!!!!!!ALL COOL STUFF WILL BE BROKEN!!!!!!!!!!!!!! %+ echo !!!!!!!!!!!!!!!ALL COOL STUFF WILL BE BROKEN!!!!!!!!!!!!!!
                call alarmbeep %+ *pause
        goto :BEGIN_COMMON

        :username_not_found
                call FATAL_ERROR "USERNAME NOT KNOWN.  YOU NEED TO ADD A :setUSERNAME subroutine to %BAT%\environm.btm"
                gosub SetMachineSpecificEnvironment
        return
       :knownname_not_found
                call FATAL_ERROR "KNOWNNAME NOT KNOWN.  YOU NEED TO DEFINE IT in %BAT%\environm.btm"
                gosub SetMachineSpecificEnvironment
        return

        :setMachinenameSubroutineNotFound
                call                      alarm-beep
                %COLOR_ALARM%   %+ echo * FATAL ERROR: MISSING MACHINE-SPECIFIC INITIALIZER FUNCTION.
                %COLOR_WARNING% %+ echo You need a subroutine in %BAT%\environm.btm that has the name setMachinename, 
                                   echo where Machinename is the same as the %%MACHINENAME%% environment variable.  
                %COLOR_ADVICE%  %+ echo For example, :setStorm and :setFire
                                   echo You probably just need to make a blank entry if you really don't 
                                   echo have any environment variables *unique* to this machine.  
                %COLOR_PAUSE%   %+ *pause
        goto :END
        
        rem ::::::::::::::::::::::::::::: ERROR SUBROUTINES: END :::::::::::::::::::::::::::::::::::::
        rem ::::::::::::::::::::::::::::: ERROR SUBROUTINES: END :::::::::::::::::::::::::::::::::::::
        rem ::::::::::::::::::::::::::::: ERROR SUBROUTINES: END :::::::::::::::::::::::::::::::::::::
        

        :SecondaryShell
                rem only really used to debug setting up the secondary shell, pretty much just a dummy/debug function
                :echo * This is a secondary shell!
                :pause
        goto :END

        :stopwatch_button [color reason]
                if %PERFORMANCE_TUNING eq 0 (return)
                set reason2=%@unquote[%reason]
                echos %[ANSI_COLOR_%COLOR%]
                echos %EMOJI_STOPWATCH%%EMOJI_STOPWATCH%
                echos  %reason2%
                echos %EMOJI_STOPWATCH%
                echos %@ANSI_MOVE_TO_COL[%@EVAL[%_COLUMNS-80]]
                timer %QUIET_TIMER_OR_NOT% /9 /s
        return

        :Load_TCC_Plugins
                set           plugin_loader=c:\bat\load-TCC-plugins.bat
                if not exist %plugin_loader% (call error "plugin loader '%italics_on%%plugin_loader%%italics_off%' does not exist")
                call         %plugin_loader%
        return


        rem 🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈 BEGIN ⤵
        rem ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ rainbow-cursor-color progress-indicator cosmetics ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ 
        rem 🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈

                rem Sample: change cursor color to red: echos %@CHAR[27][ q%@CHAR[27]]12;red%@CHAR[7] 
                
                :set_next_cursor_color_in_rainbow_sequence
                
                
                        rem Initialize the array and counter — we will use the fact that number_of_rgb_colorsteps is defined as the litmus test of needing to define it or not ... Unless we're in 
                        if defined number_of_rgb_colorsteps .and. "%1" != "force" goto :RGB_Array_Has_Been_Set_Already
                        iff "%@ARRAYINFO[rgb_steps_hex]" != "-1" then
                                set array_exists=1
                        else 
                                set array_exists=0
                        endiff                
                        rem echo array exists=%array_exists%
                        iff "%1" == "force" .and. %array_exists eq 1 then
                                UnsetArray /q rgb_steps_hex
                        endiff                                
                        rem echo %reverse_on%set_next_cursor_color_in_rainbow_sequence called, rgb_index is %rgb_index%%reverse_off% array_exists=%array_exists%
rem                     if %array_exists eq 1 .or. "%1" != "force" (goto :RGB_Array_Has_Been_Set_Already) ///NO!
                        if %array_exists eq 1                      (goto :RGB_Array_Has_Been_Set_Already)
                                set number_of_rgb_colorsteps=21
                                SetArray  rgb_steps_hex[%number_of_rgb_colorsteps%]
                                rem rray  rgb_steps_rgb[%number_of_rgb_colorsteps%]
                                set       rgb_steps_hex[00]=FF0000          %+ rem set rgb_steps_rgb[20]=255,0,255          %+ rem oops backwards
                                set       rgb_steps_hex[01]=FF3F00          %+ rem set rgb_steps_rgb[19]=191,0,255          %+ rem oops backwards
                                set       rgb_steps_hex[02]=FF7F00          %+ rem set rgb_steps_rgb[18]=127,0,255          %+ rem oops backwards
                                set       rgb_steps_hex[03]=FFBF00          %+ rem set rgb_steps_rgb[17]=63,0,255           %+ rem oops backwards
                                set       rgb_steps_hex[04]=FFFF00          %+ rem set rgb_steps_rgb[16]=0,0,255            %+ rem oops backwards
                                set       rgb_steps_hex[05]=BFFF00          %+ rem set rgb_steps_rgb[15]=0,63,255           %+ rem oops backwards
                                set       rgb_steps_hex[06]=7FFF00          %+ rem set rgb_steps_rgb[14]=0,127,255          %+ rem oops backwards
                                set       rgb_steps_hex[07]=3FFF00          %+ rem set rgb_steps_rgb[13]=0,191,255          %+ rem oops backwards
                                set       rgb_steps_hex[08]=00FF00          %+ rem set rgb_steps_rgb[12]=0,255,255          %+ rem oops backwards
                                set       rgb_steps_hex[09]=00FF3F          %+ rem set rgb_steps_rgb[11]=0,255,191          %+ rem oops backwards
                                set       rgb_steps_hex[10]=00FF7F          %+ rem set rgb_steps_rgb[10]=0,255,127          %+ rem oops backwards
                                set       rgb_steps_hex[11]=00FFBF          %+ rem set rgb_steps_rgb[09]=0,255,63           %+ rem oops backwards
                                set       rgb_steps_hex[12]=00FFFF          %+ rem set rgb_steps_rgb[08]=0,255,0            %+ rem oops backwards
                                set       rgb_steps_hex[13]=00BFFF          %+ rem set rgb_steps_rgb[07]=63,255,0           %+ rem oops backwards
                                set       rgb_steps_hex[14]=007FFF          %+ rem set rgb_steps_rgb[06]=127,255,0          %+ rem oops backwards
                                set       rgb_steps_hex[15]=003FFF          %+ rem set rgb_steps_rgb[05]=191,255,0          %+ rem oops backwards
                                set       rgb_steps_hex[16]=0000FF          %+ rem set rgb_steps_rgb[04]=255,255,0          %+ rem oops backwards
                                set       rgb_steps_hex[17]=3F00FF          %+ rem set rgb_steps_rgb[03]=255,191,0          %+ rem oops backwards
                                set       rgb_steps_hex[18]=7F00FF          %+ rem set rgb_steps_rgb[02]=255,127,0          %+ rem oops backwards
                                set       rgb_steps_hex[19]=BF00FF          %+ rem set rgb_steps_rgb[01]=255,63,0           %+ rem oops backwards
                                set       rgb_steps_hex[20]=FF00FF          %+ rem set rgb_steps_rgb[00]=255,0,0            %+ rem oops backwards
                                if "%1" != "force" (set rgb_index=0)
                                rem set   DEBUG_CURSOR=2
                        :RGB_Array_Has_Been_Set_Already

                        iff %rgb_index% eq %number_of_rgb_colorsteps% then
                                set rgb_index=1
                        endiff                        
                        iff %rgb_index% LE %number_of_rgb_colorsteps% then
                                set color=%rgb_steps_hex[%rgb_index]
                                rem debug: set color_setter= @ANSI_CURSOR_COLOR_BY_HEX[%color] %@ANSI_CURSOR_COLOR_BY_HEX[%color]
                                rem color_setter=%@ANSI_CURSOR_COLOR_BY_HEX[%color]
                                set color_setter=%@char[27][ q%@CHAR[27]]12;#%[color]%@CHAR[7]
                                rem Get individual R,G,B values:
                                        set r=%@word[0,%color%,,] 
                                        set g=%@word[1,%color%,,] 
                                        set b=%@word[2,%color%,,]
                                iff %DEBUG_CURSOR% GT 1 then
                                        echo %color_setter%%@format[2,%rgb_index%] TEST - This: color=%@format[11,%color%] / r=%@format[3,%r], g=%@format[3,%g], b=%@format[3,%b] / %%@CHAR[27][38;2;%r%;%g%;%b%m%color%@CHAR[27][0m%%@CHAR[7] - 
                                        rem *pause>nul
                                        delay /m 250
                                else
                                        echos %color_setter%
                                        rem echo {%rgb_index} ^ *pause>nul
                                endiff
                                set /a rgb_index=%rgb_index%+1
                                return
                        else
                                rem echo All values processed.
                                return
                        endiff
                :return
                
        rem 🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈 END ↖
        rem ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ rainbow-cursor-color progress-indicator cosmetics ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ ‼ 
        rem 🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈🌈



        rem   ::::::::::::::::::::::::::::::: SUBROUTINES: END :::::::::::::::::::::::::::::::::::::::
        rem   ::::::::::::::::::::::::::::::: SUBROUTINES: END :::::::::::::::::::::::::::::::::::::::
        rem   ::::::::::::::::::::::::::::::: SUBROUTINES: END :::::::::::::::::::::::::::::::::::::::

















:END━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
:END━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
:END━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
:END

:Cleanup
                REM sunset this code because we don't use XP/2K machines anymore: if "%OS%" eq "XP" .or. "%OS%" eq "2K" (title 4NT)
                if "%@UPPER[%1]" == "DEBUG" (set DEBUG=%DEBUG_TMP%)


:The_Very_END
                SET ENVIRONM_RUN=1
                set RUNNING_ENVIRONM=0


:POST_end
        rem ❇❇❇ Performance tuning ❇❇❇
                timer %QUIET_TIMER_OR_NOT% /9 off
                                : 20240911: environm {norml} - 0.023
                                :           environm {fresh} - 2.500
                                :           environm  force  - 3.700
                                : 20260803: environm  force  - same after major optimization

        rem ❇❇❇ Reset the cursor to normal ❇❇❇
        rem (and possibly ensure our custom pentagram is actually created [bugfix kludge]_
        rem 2024/11/15: set-ansi force definitely fixes the disappearing pentagram issue, but aborting environm.btm mid-way leaves it broken *after*, so whatever is breaking it can and is still fixed by echo'ing our %create_pentagram% string
                echos %CURSOR_RESET%%CREATE_PENTAGRAM%

                    
        rem ❇❇❇ Reset the window title: ❇❇❇
                title TCC


:Possibly_Run_Next_Command
        rem Sometimes this script is passed an additional command to be run at the end:
        rem This is passed via “NEXTCOMMAND” environment variable:
                iff "%NEXTCOMMAND%" != "" then
                        set LAST_COMMAND=NEXTCOMMAND
                        unset /q         NEXTCOMMAND
                        %LAST_COMMAND%
                endiff

:Horribly_unnecessary_trash_cleanup_that_we_want_done_very_often
        rem OCULUS RIFT PLEEEEEEEAAASE WHY ARE YOU DOING THIS: —— TODO move to autoexec purge
                if exist c:\*.json *del c:\*.json
        
        