                        %gosubValidateFolderExists% MP3OFFICIALDRIVE   NOW_PLAYING_TXT
                        %gosubValidateFolderExists% MP3OFFICIALDRIVE   NOW_PLAYING_ART
                        %gosubValidateFolderExists% MP3OFFICIALDRIVE   ALL_SONGS_FILELIST
