                                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  ::::: MUSICSERVERCDRIVE=%HD512G%
                                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  MUSICSERVERCDRIVE=%HD1T3%
                                :rem done in environm.btm ::::: moved to environment-common-vars ➜  endiff
                                :rem done in environm.btm ::::: moved to environment-common-vars ➜  MUSICSERVERC_DRIVE=%MUSICSERVERCDRIVE%                               %+ ::::: just an alias

                        :rem Music server: WinAmp Status file:
                                WINAMP_NOW_PLAYING_TXT=%MP3OFFICIAL%\lists\winamp_now_playing.txt
                                WINAMP_NOW_PLAYING_ART=%MP3OFFICIAL%\lists\winamp_now_playing.jpg
                                :rem ::::: a list of all the songs in your music collection! basically, dir /s /b c:\mp3\%FILEMASK_AUDIO%:
                                    ALL_SONGS_FILELIST=%MP3OFFICIAL%\lists\everything.m3u
                                :rem ::::: an alias so we can be sloppy in remembering things. It is both a filelist and a playlist 😉:
                                    ALL_SONGS_PLAYLIST=%ALL_SONGS_FILELIST%
                                    ALL_SONGS_LIST=%ALL_SONGS_FILELIST%


                        :rem Music server: General status file: [which is just the WinAmp status file]:
                                NOW_PLAYING_ALBUM_ART=%WINAMP_NOW_PLAYING_ART%
                                      NOW_PLAYING_ART=%WINAMP_NOW_PLAYING_ART%
                                NOW_PLAYING_SONG_INFO=%WINAMP_NOW_PLAYING_TXT%
                                      NOW_PLAYING_TXT=%WINAMP_NOW_PLAYING_TXT%

                :rem done in environm.btm ::::: moved to environment-common-vars ➜  ::::: ✔***** VALIDATIONS: *****
                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  ::::: Not sure where this gets set, so not validating it: %gosubValidateFolderExists% WAWILOGSDRIVE WAWILOGS
                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  ::::: Not sure where this gets set, so not validating it: %gosubValidateFolderExists% WAWILOGSDRIVE WAWILOGS
                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  %gosubValidateFolderExists% MP3OFFICIALDRIVE   NOW_PLAYING_TXT
                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  %gosubValidateFolderExists% MP3OFFICIALDRIVE   NOW_PLAYING_ART
                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  %gosubValidateFolderExists% MP3OFFICIALDRIVE   ALL_SONGS_FILELIST
                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  %gosubValidateFolderExists% MP3VERSIONINGDRIVE MP3VERSIONING
                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  %gosubValidateFolderExists% MP3BACKUP1DRIVE    MP3_BACKUP_1
                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  %gosubValidateFolderExists% MP3BACKUP2DRIVE    MP3_BACKUP_2
                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  %gosubValidateFolderExists% MP3BACKUP3DRIVE    MP3_BACKUP_3
