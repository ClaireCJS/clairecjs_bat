        :rem ————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————
                :rem CLAIRE-VIRONMENT VARIABLE DEFAULT VALUES:
                        :rem Operating-system values:
                                OS=10
                                OSBIT=64
                        :rem Main locations: BAT:
                                BATDRIVE=C
                                BAT=%BATDRIVE%:\BAT
                                HOME=%BAT%
                        :rem Main locations: UTIL:
                                UTILDRIVE=C
                                :rem done in environm bat -> if     isdir %UTILDRIVE%:\UTIL (UTIL=%UTILDRIVE%:\UTIL)
                                :rem done in environm bat -> if not isdir %UTILDRIVE%:\UTIL (UTIL=%BAT%            )
                                UTIL1DRIVE=%UTILDRIVE%
                                UTIL1=%UTIL%
                                UTIL2DRIVE=C
                                UTIL2=%UTIL2DRIVE%:\UTIL2
                        :rem Default text editor, and separate BG command to call the text in the background:
