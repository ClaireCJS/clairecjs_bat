                :rem 💿***** MUSIC COLLECTION STUFF: *****

                        :rem music collection location:
                                :rem MP3OFFICIALDRIVE=%HD18T1%  :THAILOG (mp3 official server for 2015-2022)
                                MP3OFFICIALDRIVE=%HD18T3%
                                        MP3DRIVE=%HD18T3%
                                     MP3OFFICIAL=%MP3OFFICIALDRIVE%:\mp3
                                    MP3_OFFICIAL=%MP3OFFICIAL%
                                           MP3CL=%MP3OFFICIAL%
                                             MP3=%MP3OFFICIAL%

                        :rem music collection's 3 backup locations:
                                :rem MP3BACKUP1DRIVE=%HD4000G2% %+ MP3BACKUP1=%MP3BACKUP1DRIVE%:\BACKUPS\mp3
                                :rem MP3BACKUP2DRIVE=%HD10000G2 %+ MP3BACKUP2=%MP3BACKUP2DRIVE%:\BACKUPS\mp3
                                :rem Wyvern copy:
                                        MP3BACKUP1DRIVE=%HD18T2%
                                        MP3BACKUP1=%MP3BACKUP1DRIVE%:\BACKUPS\mp3
                                :rem Thailog copy:
                                        MP3BACKUP2DRIVE=%HD20T1
                                        MP3BACKUP2=%MP3BACKUP2DRIVE%:\BACKUPS\mp3
                                :rem Demona copy:
                                        MP3BACKUP3DRIVE=%HD18000G%
                                        MP3BACKUP3=%MP3BACKUP3DRIVE%:\mp3
                                :rem Aliases:
                                        MP3_BACKUP_1_DRIVE=%MP3BACKUP1DRIVE%
                                        MP3_BACKUP_2_DRIVE=%MP3BACKUP2DRIVE%
                                        MP3_BACKUP_3_DRIVE=%MP3BACKUP3DRIVE%
                                        MP3_BACKUP_1=%MP3BACKUP1%
                                        MP3_BACKUP_2=%MP3BACKUP2%
                                        MP3_BACKUP_3=%MP3BACKUP3%
                                :rem The backup we intend to use first if the main repo goes down
                                        :rem SECONDARY=%MP3BACKUP3%
                                        MP3_SECONDARY=%MP3BACKUP1%
                                        MP3SECONDARY=%MP3_SECONDARY%

                        :rem music collection's Auxilary collection (where mp3s go when replaced by FLACs, among other things), and it's backup:
                                :rem Must be on same drive as MP3OFFICIAL for reasons! This is a special repo for redundant files like .bak, .mp3 when there is a .flac, .mp3s that were .mp3.deprecated in the official repo
                                                   MP3AUX=%MP3OFFICIALDRIVE%:\mp3-aux
                                        MP3AUXBACKUPDRIVE=%MP3BACKUP1DRIVE%
                                        MP3AUXBACKUP=%MP3AUXBACKUPDRIVE%:\BACKUPS\mp3-aux

                        :rem music collection's version control repo:
                                MP3VERSIONINGDRIVE=%MP3OFFICIALDRIVE%
                                MP3VERSIONING=%MP3VERSIONINGDRIVE%:\mp3-git-repo
                                MP3VERSIONINGBACKUPDRIVE=%HD18000G%
                                MP3VERSIONINGBACKUP=%MP3VERSIONINGBACKUPDRIVE%:\mp3-git-repo
                                :rem Aliases (used in some old scripts):
                                        MP3_SVN_REPO_DIR=%MP3VERSIONING%
                                        MP3_SVN_REPO_URL=file:///%MP3_SVN_REPO_DIR%


                :rem 💻***** MUSIC SERVER STUFF: *****

                        :rem which machine is our Music Server, and what it's IP address is:
                                  MUSICSERVERMACHINENAME=DEMONA
                                  MUSICSERVERIPONLY=%IP_DEMONA%
                                  WINAMP_INTEGRATION_GENERAL=0
                                :rem done in environm.btm ::::: moved to environment-common-vars ➜  if  "%MUSICSERVERMACHINENAME%" == "%MACHINENAME%" (MUSICSERVERIPONLY=localhost   %+ WINAMP_INTEGRATION_GENERAL=1)
                                :rem done in environm.btm ::::: moved to environment-common-vars ➜  if   "WORK"                    == "%MACHINENAME%" (MUSICSERVERIPONLY=%PUBLIC_IP% %+ WINAMP_INTEGRATION_GENERAL=1)

                        :rem Music server stuff: the port of the music server web interface, and 'MUSICSERVER' which is a [badly-named] URL-base:
                                MUSICSERVERPORT=666
                                MUSICSERVER=%MUSICSERVERIPONLY%:%MUSICSERVERPORT%
                                MUSICSERVERSTATUSURL=http://%MUSICSERVER%/main

                        :rem Music server stuff: Which drive is the C: drive of the music server?
                                :rem done in environm.btm ::::: moved to environment-common-vars ➜  iff "%MUSICSERVERMACHINENAME%" == "%MACHINENAME%" then
                                        :rem done in environm.btm ::::: moved to environment-common-vars ➜  MUSICSERVERCDRIVE=C
                                :rem done in environm.btm ::::: moved to environment-common-vars ➜  else
