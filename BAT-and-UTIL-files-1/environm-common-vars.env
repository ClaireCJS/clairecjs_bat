        rem
        rem
        :rem :::::: DEFINE DRIVE REMAPPING (reverse lookup to convert drive letter to %HDxxxG environment variable):
        rem
:       rem
        :rem         :rem :::::::::::::::::::::::::::::::::::::::::::::::::: Doing this is quite awesome, because now we can catalog filelists                        %+ ::::: Consider: When new computer is added
        :rem         :rem :::::::::::::::::::::::::::::::::::::::::::::::::: made for any machine and pipe them through remap.pl %REMAP<MACHINENAME>
        :rem         :rem :::::::::::::::::::::::::::::::::::::::::::::::::: (no need to remember the %REMAP<MACHINENAME> argument, which is hard to script,
        :rem         :rem ::::::::::::::::::::::::::::::::::::::::::::::::::  because remap.pl automatically checks the environment for %REMAP%MACHINEMAME)
        :rem         :rem :::::::::::::::::::::::::::::::::::::::::::::::::: and the drive letters will be automagically adjusted to be accurate for
        :rem         :rem :::::::::::::::::::::::::::::::::::::::::::::::::: whichever machine we are on, i.e if Sally calls HD40G Q:, and Harry called HD40G X:, this mapping will change Q: to X:
        :rem         :rem ::::::::::::::::::::::::::::::::::::::::REMAPSTORM=c,%HD60G d,%HD40G e,%HD80G2 f,%HD120G g,%HD80G h,%HD16G i,%HD80G m,%HD25G n,%HD80G3 s,%HD60G t,%HD40G u,%HD80G2 v,%HD120G
        :rem         :rem :::::::::::::::::::::::::::::::::::::::: REMAPFIRE=c,%HD16G d,%HD80G e,%HD80G2 f,%HD120G g,%HD80G h,%HD16G i,%HD80G m,%HD25G n,%HD80G3 s,%HD60G t,%HD40G u,%HD80G2 v,%HD120G
        :rem         :rem :::::::::::::::::::::::::::::::::::::::: REMAPMIST=c,%HD25G          e,%HD80G2 f,%HD120G g,%HD80G h,%HD16G i,%HD80G m,%HD25G n,%HD80G3 s,%HD60G t,%HD40G u,%HD80G2 v,%HD120G
        :rem         :rem ::::::::::::::::::::::::::::::::::::::REMAPSTORM=c,%HD60G d,%HD40G e,%HD80G2 f,%HD120G g,%HD80G h,%HD16G i,%HD80G j,%HD120G2 m,%HD25G n,%HD80G3 s,%HD60G   t,%HD40G u,%HD80G2 v,%HD120G
        :rem         :rem ::::::::::::::::::::::::::::::::::::::: REMAPFIRE=c,%HD16G d,%HD80G e,%HD80G2 f,%HD120G g,%HD80G h,%HD16G i,%HD80G j,%HD120G2 m,%HD25G n,%HD80G3 s,%HD60G   t,%HD40G u,%HD80G2 v,%HD120G
